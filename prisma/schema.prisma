datasource db {
  // Prod / Supabase = postgresql. En local, pointe DATABASE_URL vers Supabase aussi.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String         @id @default(cuid())
  email     String         @unique
  password  String
  name      String?
  role      String         @default("user") // "user" | "admin"
  createdAt DateTime       @default(now())
  progress  UserProgress[]
  videos    Video[]

  // Communauté
  invitesCreated      Invite[]
  friendshipsSent     Friendship[] @relation("FriendshipRequester")
  friendshipsReceived Friendship[] @relation("FriendshipAddressee")

  // Séjours
  tripsCreated          Trip[]                @relation("TripCreator")
  tripMemberships       TripMember[]
  tripFiguresAdded      TripFigure[]          @relation("TripFigureAdder")
  tripMemberObjectives  TripMemberObjective[]
}

model Figure {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String
  description String
  steps       String // JSON.stringify(string[])
  order       Int      @default(0)
  /// Visible sur /figures (et dashboards users) si true
  active      Boolean  @default(true)

  prerequisites Figure[] @relation("Prerequisites")
  unlocks       Figure[] @relation("Prerequisites")

  progress          UserProgress[]
  videos            Video[]
  tripFigures       TripFigure[]
  memberObjectives  TripMemberObjective[]
}

model UserProgress {
  id          String    @id @default(cuid())
  userId      String
  figureId    String
  completed   Boolean   @default(false)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  figure Figure @relation(fields: [figureId], references: [id], onDelete: Cascade)

  @@unique([userId, figureId])
}

model Video {
  id        String   @id @default(cuid())
  figureId  String
  userId    String
  url       String
  title     String?
  createdAt DateTime @default(now())

  figure Figure @relation(fields: [figureId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Demande / lien d'amitié entre deux riders
model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("pending") // pending | accepted | declined
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

/// Lien d'invitation partageable (code) — l'ami s'inscrit et devient ami auto
model Invite {
  id        String    @id @default(cuid())
  code      String    @unique
  creatorId String
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  usedCount Int       @default(0)
  maxUses   Int       @default(50)

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
}

/// Séjour kite (ex: Dakhla 12 jours) — XP via completedAt dans la fenêtre de dates
model Trip {
  id          String   @id @default(cuid())
  name        String
  location    String?
  description String?
  startDate   DateTime
  endDate     DateTime
  inviteCode  String   @unique
  creatorId   String
  createdAt   DateTime @default(now())

  creator    User                  @relation("TripCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members    TripMember[]
  figures    TripFigure[]
  objectives TripMemberObjective[]

  @@index([startDate, endDate])
  @@index([creatorId])
}

model TripMember {
  id       String   @id @default(cuid())
  tripId   String
  userId   String
  role     String   @default("member") // owner | member
  joinedAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([userId])
}

/// Figure ajoutée à la liste partagée du séjour (visible par tout le crew)
model TripFigure {
  id        String   @id @default(cuid())
  tripId    String
  figureId  String
  addedById String
  createdAt DateTime @default(now())

  trip    Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  figure  Figure @relation(fields: [figureId], references: [id], onDelete: Cascade)
  addedBy User   @relation("TripFigureAdder", fields: [addedById], references: [id], onDelete: Cascade)

  @@unique([tripId, figureId])
  @@index([tripId])
}

/// Objectif perso d'un rider sur une figure de la liste du séjour
model TripMemberObjective {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  figureId  String
  createdAt DateTime @default(now())

  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  figure Figure @relation(fields: [figureId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId, figureId])
  @@index([tripId, userId])
  @@index([tripId, figureId])
}
