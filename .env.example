# Supabase → Settings → Database → URI (mode "URI" / Transaction pooler ok pour l'app)
# Exemple: postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:PASSWORD@db.psumzbomklrflallniuy.supabase.co:5432/postgres"
NEXTAUTH_SECRET="remplace-moi-par-une-chaine-aleatoire-longue"
NEXTAUTH_URL="http://localhost:3000"

# Supabase (DB + avatars) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJ...service_role..."

# Cloudflare R2 — vidéos figures (voir docs/r2-setup.md)
