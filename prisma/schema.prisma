datasource db {
  // Prod / Supabase = postgresql. En local, pointe DATABASE_URL vers Supabase aussi.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String         @id @default(cuid())
  email     String         @unique
  password  String
  name      String?
  /// Pseudo public unique (@marin) — pour retrouver ses amis
  username  String?        @unique
  /// URL publique photo de profil (Supabase Storage)
  image     String?
  /// Chemin Storage pour remplacer / supprimer
  imagePath String?
  role      String         @default("user") // "user" | "admin"
  /// Poids rider (kg) — utilisé par l'assistant taille d'aile
  weightKg  Float?
  createdAt DateTime       @default(now())
  progress  UserProgress[]
  videos    Video[]

  // Communauté
  invitesCreated      Invite[]
  preInvitesCreated   PreInvite[] @relation("PreInviteCreator")
  preInviteClaimed    PreInvite?  @relation("PreInviteClaimed")
  friendshipsSent     Friendship[] @relation("FriendshipRequester")
  friendshipsReceived Friendship[] @relation("FriendshipAddressee")

  // Séjours
  tripsCreated          Trip[]                @relation("TripCreator")
  tripMemberships       TripMember[]
  tripFiguresAdded      TripFigure[]          @relation("TripFigureAdder")
  tripMemberObjectives  TripMemberObjective[]
  tripSeatsClaimed      TripSeat[]            @relation("TripSeatClaimed")

  // Matériel kite perso
  gear                  Gear[]

  // Journal de sessions & spots
  spots        Spot[]
  kiteSessions KiteSession[]

  // Carnet de progression & défis
  figureNotes        FigureNote[]
  challengesSent     Challenge[] @relation("ChallengeCreator")
  challengesReceived Challenge[] @relation("ChallengeOpponent")
}

model Figure {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String
  description String
  steps       String // JSON.stringify(string[])
  order       Int      @default(0)
  /// Visible sur /figures (et dashboards users) si true
  active      Boolean  @default(true)

  prerequisites Figure[] @relation("Prerequisites")
  unlocks       Figure[] @relation("Prerequisites")

  progress          UserProgress[]
  videos            Video[]
  tripFigures       TripFigure[]
  memberObjectives  TripMemberObjective[]
  notes             FigureNote[]
  challenges        Challenge[]
}

/// Note perso du rider sur une figure (carnet de progression)
model FigureNote {
  id        String   @id @default(cuid())
  userId    String
  figureId  String
  content   String
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  figure Figure @relation(fields: [figureId], references: [id], onDelete: Cascade)

  @@unique([userId, figureId])
}

/// Défi entre amis : premier à valider la figure avant la deadline
model Challenge {
  id         String   @id @default(cuid())
  creatorId  String
  opponentId String
  figureId   String
  deadline   DateTime
  /// pending | accepted | declined — le gagnant est dérivé de UserProgress
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  creator  User   @relation("ChallengeCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  opponent User   @relation("ChallengeOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  figure   Figure @relation(fields: [figureId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([opponentId])
}

model UserProgress {
  id          String    @id @default(cuid())
  userId      String
  figureId    String
  completed   Boolean   @default(false)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  figure Figure @relation(fields: [figureId], references: [id], onDelete: Cascade)

  @@unique([userId, figureId])
}

model Video {
  id          String   @id @default(cuid())
  figureId    String
  userId      String
  /// URL publique Supabase Storage
  url         String
  /// Chemin dans le bucket figure-videos (ex. figureId/videoId.mp4)
  storagePath String
  title       String?
  mimeType    String?
  sizeBytes   Int?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  figure Figure @relation(fields: [figureId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([figureId, order])
}

/// Demande / lien d'amitié entre deux riders
model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("pending") // pending | accepted | declined
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

/// Lien d'invitation partageable (code) — l'ami s'inscrit et devient ami auto
model Invite {
  id        String    @id @default(cuid())
  code      String    @unique
  creatorId String
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  usedCount Int       @default(0)
  maxUses   Int       @default(50)

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
}

/// Pré-invitation admin : email (+ nom / photo) — inscription uniquement sur code
model PreInvite {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  image     String?
  imagePath String?
  code      String    @unique
  creatorId String
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  usedById  String?   @unique

  creator User  @relation("PreInviteCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  usedBy  User? @relation("PreInviteClaimed", fields: [usedById], references: [id], onDelete: SetNull)

  @@index([creatorId])
  @@index([usedAt])
}

/// Séjour kite (ex: Dakhla 12 jours) — XP via completedAt dans la fenêtre de dates
model Trip {
  id          String   @id @default(cuid())
  name        String
  location    String?
  description String?
  startDate   DateTime
  endDate     DateTime
  inviteCode  String   @unique
  creatorId   String
  createdAt   DateTime @default(now())

  creator    User                  @relation("TripCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members    TripMember[]
  figures    TripFigure[]
  objectives TripMemberObjective[]
  seats      TripSeat[]

  @@index([startDate, endDate])
  @@index([creatorId])
}

/// Place « qui es-tu ? » sur le lien d’invitation (prénom + photo + email opt.)
model TripSeat {
  id          String   @id @default(cuid())
  tripId      String
  displayName String
  email       String?
  image       String?
  imagePath   String?
  order       Int      @default(0)
  claimedById String?
  createdAt   DateTime @default(now())

  trip      Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  claimedBy User? @relation("TripSeatClaimed", fields: [claimedById], references: [id], onDelete: SetNull)

  @@unique([tripId, claimedById])
  @@index([tripId])
}

model TripMember {
  id       String   @id @default(cuid())
  tripId   String
  userId   String
  role     String   @default("member") // owner | member
  joinedAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([userId])
}

/// Figure ajoutée à la liste partagée du séjour (visible par tout le crew)
model TripFigure {
  id        String   @id @default(cuid())
  tripId    String
  figureId  String
  addedById String
  createdAt DateTime @default(now())

  trip    Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  figure  Figure @relation(fields: [figureId], references: [id], onDelete: Cascade)
  addedBy User   @relation("TripFigureAdder", fields: [addedById], references: [id], onDelete: Cascade)

  @@unique([tripId, figureId])
  @@index([tripId])
}

/// Objectif perso d'un rider sur une figure de la liste du séjour
model TripMemberObjective {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  figureId  String
  createdAt DateTime @default(now())

  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  figure Figure @relation(fields: [figureId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId, figureId])
  @@index([tripId, userId])
  @@index([tripId, figureId])
}

/// Pièce de matériel kite (aile, barre, planche…) — propriétaire = user
model Gear {
  id            String    @id @default(cuid())
  userId        String
  /// aile | barre | harnais | planche | straps | pads | foil | casque | combinaison | leash | pompe | ailerons | wing | accessoire | autre
  category      String
  brand         String?
  model         String
  /// Surnom optionnel (ex. "la 9m freeride")
  name          String?
  /// Taille libre : "9m", "138×41", "M"…
  size          String?
  year          Int?
  purchaseDate  DateTime?
  purchasePrice Float?
  /// Nombre de sorties / sessions
  sessionCount  Int       @default(0)
  notes         String?
  invoiceName   String?
  invoiceMime   String?
  invoiceData   Bytes?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionLinks SessionGear[]

  @@index([userId, category])
  @@index([userId])
}

/// Spot de kite perso — coordonnées utilisées pour la météo Open-Meteo
model Spot {
  id        String   @id @default(cuid())
  userId    String
  name      String
  /// Optionnel — plus saisi dans l’UI ; utile si déjà renseigné pour la météo
  latitude  Float?
  longitude Float?
  /// Orientations de vent qui marchent (texte libre : "NO–NE", "thermique O…")
  windOrientation String?
  /// flat | chop | vagues | mixte
  waterType String?
  /// Spot favori : affiché en widget météo sur le dashboard
  favorite  Boolean  @default(false)
  createdAt DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions KiteSession[]

  @@index([userId, favorite])
}

/// Session kite loggée (journal) — alimente les compteurs matériel
model KiteSession {
  id          String   @id @default(cuid())
  userId      String
  spotId      String?
  date        DateTime
  durationMin Int?
  windKnots   Float?
  /// Ressenti / notes de session
  notes       String?
  createdAt   DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  spot     Spot?         @relation(fields: [spotId], references: [id], onDelete: SetNull)
  gearUsed SessionGear[]

  @@index([userId, date])
}

/// Matériel utilisé pendant une session (compteur de sorties automatique)
model SessionGear {
  id        String @id @default(cuid())
  sessionId String
  gearId    String

  session KiteSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  gear    Gear        @relation(fields: [gearId], references: [id], onDelete: Cascade)

  @@unique([sessionId, gearId])
  @@index([gearId])
}
