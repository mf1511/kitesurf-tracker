R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="kitequest-videos"
NEXT_PUBLIC_R2_PUBLIC_BASE_URL="https://pub-xxxxx.r2.dev"
